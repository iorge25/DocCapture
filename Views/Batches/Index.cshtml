@model List<DocCapture.Models.Entities.Batch>
@{
    ViewData["Title"] = "Batches";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Batches</h2>
    <a asp-action="Create" class="btn btn-primary">New Batch</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No batches yet. Create one to start uploading documents.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Form Template</th>
                <th class="text-center">Documents</th>
                <th class="text-center">Verified</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                var total = b.Documents.Count;
                var done = b.Documents.Count(d =>
                d.Status == DocCapture.Models.Entities.DocumentStatus.InReview ||
                d.Status == DocCapture.Models.Entities.DocumentStatus.Verified);
                var pct = total == 0 ? 0 : (int)Math.Round(done * 100.0 / total);

                <tr>
                    <td><strong>@b.Name</strong></td>
                    <td>@b.FormTemplate?.Name</td>
                    <td class="text-center">@total</td>
                    <td style="min-width:160px;">
                        <div class="progress" style="height:18px;">
                            <div class="progress-bar" role="progressbar" style="width:@pct%;">@pct%</div>
                        </div>
                    </td>
                    <td>@b.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary">Open</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}